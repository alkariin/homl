# Copy this file to .env (same folder) and replace placeholder values.
# This template matches env names used by src/config/config.go.

ENVIRONMENT=DEV
HOST=http://localhost:8080
HOML_API_URL=/api
HANDLER_TIMEOUT=5

# Allowed CORS origin. Required (explicit, non-wildcard) outside DEV.
CORS_ORIGIN=http://localhost:8080

# Password-reset email (SMTP). When SMTP_HOST is empty the 6-digit reset code is
# logged to the console instead of being emailed (the usual DEV setup). Set it —
# even in DEV — to exercise the real SMTP path against Mailpit; see
# docker-compose.local.example.yml.
# Port 587 uses STARTTLS, 465 implicit TLS. SMTP_USER defaults to SMTP_FROM,
# which only works with mailbox providers: API relays need their own username
# (SendGrid "apikey", SES IAM credentials, Mailgun postmaster@domain). An empty
# SMTP_PASSWORD disables authentication, for local catchers only.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no_reply@homl.ch
SMTP_USER=
SMTP_PASSWORD=

# Local backend execution (make local / go run .)
MYSQL_ADDRESS=localhost:3306
MYSQL_USER=homl
MYSQL_PASSWORD=change_me_mysql
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=change_me_redis

# Docker DB container bootstrap
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=homl
MYSQL_USER=homl

# Secrets: at least 32 chars, no "change_me" placeholder.
# Generate each with: openssl rand -base64 32
ACCESS_SECRET=
REFRESH_SECRET=
ENCRYPT_SECRET=


