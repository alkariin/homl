# Copy this file to .env (same folder) and replace placeholder values.
# This template matches env names used by src/config/config.go.

ENVIRONMENT=DEV
HOST=http://localhost:8080
HOML_API_URL=/api
HANDLER_TIMEOUT=5

# Local backend execution (make local / go run .)
MYSQL_ADDRESS=localhost:3306
MYSQL_USER=homl
MYSQL_PASSWORD=change_me_mysql
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=change_me_redis

# Docker DB container bootstrap
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=homl
MYSQL_USER=homl

ACCESS_SECRET=change_me_access_secret
REFRESH_SECRET=change_me_refresh_secret
ENCRYPT_SECRET=change_me_encrypt_secret


