# Machine-specific overrides — copy to .env.local (gitignored).
# Values here are exported by the Makefile and forwarded as Docker build-args
# via Makefile.local / docker-compose.local.yml.

# Corporate proxy (leave empty on unrestricted networks)
HTTP_PROXY=http://proxy.corp:3128/
HTTPS_PROXY=http://proxy.corp:3128/
NO_PROXY=localhost,127.0.0.1,.corp

# Base64-encoded PEM certificate chain for custom CAs injected during Docker build.
# Generate with: base64 -w0 /path/to/ca-chain.pem
EXTRA_CA_CERT_B64=
