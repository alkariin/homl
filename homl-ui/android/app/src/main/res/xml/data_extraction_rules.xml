<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app travels in a cloud backup or a device-to-device
     transfer: the secure storage cannot be decrypted on another device (its
     keys stay in this one's keystore), and the data saved for offline use is
     fetched again after a login. Android 12+ reads these rules; older versions
     follow android:allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
